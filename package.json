{
  "name": "@ivan-kouznetsov/clear-fetch",
  "version": "1.0.0",
  "description": "A lightweight, production-safe HTTP logging wrapper for native Node.js fetch.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivan-Kouznetsov/clear-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/Ivan-Kouznetsov/clear-fetch/issues"
  },
  "homepage": "https://github.com/Ivan-Kouznetsov/clear-fetch#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fetch",
    "http",
    "logging",
    "logger",
    "sqlite",
    "wrapper",
    "node",
    "request",
    "response",
    "debugging"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "test:unit": "npm run build && node --test test/unit/**/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration.real-http.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:cov": "node --experimental-test-coverage --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@types/node": "^22.19.20",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.6.0",
    "prettier": "^3.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
